@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Strings
@using TanglawSite.Models
@{
    Layout = "master.cshtml";
    var home = Model.Root();
    var stats = new[] { "statsLine1", "statsLine2", "statsLine3" }
        .Select(a => home.Value<string>(a))
        .Where(s => !string.IsNullOrWhiteSpace(s) && s.Contains('|'))
        .Select(s => s!.Split('|', 2))
        .ToList();
    var values = TextLines.Pairs(Model.HasProperty("values") ? Model.Value<string>("values") : null);
    string[] valueIcons = { "target", "shield", "chart", "users", "check-circle", "compass" };
}

@await Html.PartialAsync("pageHeader", Model)

@if (stats.Any())
{
    <section class="stats" aria-label="Key figures">
        <div class="container">
            <div class="stats-grid reveal">
                @foreach (var s in stats)
                {
                    <div class="stat"><span class="stat-value" data-count>@s[0].Trim()</span><span class="stat-label">@s[1].Trim()</span></div>
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container split">
        <div class="rte reveal">
            @Html.Raw(Model.Value<IHtmlEncodedString>("bodyText")?.ToHtmlString())
        </div>
        <div class="media-stack reveal reveal-right">
            <div class="main img-reveal"><img class="fade" src="@SiteImages.Pick(Model, "sideImage", "about-side", 900, 1000)" alt="" loading="lazy" /></div>
            <div class="small img-reveal" style="--d:3"><img class="fade" src="@SiteImages.Pick(home, "introImage", "intro-main", 600, 450)" alt="" loading="lazy" /></div>
        </div>
    </div>
</section>

@if (values.Any())
{
    <section class="section section-dark">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow reveal">Why clients choose us</span>
                    <h2 class="reveal" style="--d:1">@(Model.Value<string>("valuesTitle"))</h2>
                </div>
            </div>
            <div class="values">
                @for (var v = 0; v < values.Count; v++)
                {
                    <div class="value reveal" style="--d:@(v % 4)">
                        <span class="icon-box">@Icons.Get(TextLines.IconAt(v, valueIcons))</span>
                        <h3>@values[v].Title</h3>
                        @if (!string.IsNullOrWhiteSpace(values[v].Text)) {<p>@values[v].Text</p>}
                    </div>
                }
            </div>
        </div>
    </section>
}

@await Html.PartialAsync("pageCta", Model)
